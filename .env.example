# Local development. With an http SSO_WEB_URL the cookie is host-only and not Secure.
SSO_WEB_URL='http://127.0.0.1:8773/sso'
SSO_COOKIE_DOMAIN=''

SSO_FEISHU_DEFAULT_APP_ID=''
SSO_FEISHU_DEFAULT_APP_SECRET=''
SSO_FEISHU_PARTNER_APP_ID=''
SSO_FEISHU_PARTNER_APP_SECRET=''
SSO_FEISHU_PARTNER_TENANT_KEY=''

# A local or disposable MySQL with schema/yice_sso.sql applied; never a production database from a laptop.
SSO_MYSQL_HOST='127.0.0.1'
SSO_MYSQL_PORT='3306'
SSO_MYSQL_USER=''
SSO_MYSQL_PASSWORD=''
SSO_MYSQL_DB='yice_sso'
SSO_DIRECTORY_DB='yice_information'

SSO_CALLER_INFO_TOKEN=''
SSO_CALLER_TASK_TOKEN=''

# Client side of the CLI (health / verify): the internal API and the caller token it presents.
SSO_API_URL='http://127.0.0.1:8773'
SSO_API_TOKEN=''
