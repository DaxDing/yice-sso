[Unit]
Description=yice-sso health probe (alerts via yice-notification, at most once per hour)
After=yice-sso.service

[Service]
Type=oneshot
WorkingDirectory=/opt/yice/yice-sso/current
EnvironmentFile=/opt/yice/yice-sso/.env
Environment=SSO_ENV_FILE=/dev/null
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/yice/yice-sso/current/.venv/bin/python -m sso_service.cli probe
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=96M
