# /opt/yice/yice-sso/.env on the server (root, chmod 600). Never commit real values.
# Do not set SSO_ACCESS_LOG_PATH / SSO_HOST here: the systemd unit owns them.

# Browser entry behind the parent-domain nginx, and the parent domain that receives the session cookie.
SSO_WEB_URL='https://example.com/sso'
SSO_COOKIE_DOMAIN='example.com'
# Optional ICP filing number shown in the page footer; empty hides the footer.
SSO_ICP=''

# Feishu login apps declared in config/providers.v1.json (values only here). See docs/feishu-apps.md.
# default = the main enterprise (directory: active-member list).
SSO_FEISHU_DEFAULT_APP_ID=''
SSO_FEISHU_DEFAULT_APP_SECRET=''
# partner = another enterprise admitted by tenant_key.
SSO_FEISHU_PARTNER_APP_ID=''
SSO_FEISHU_PARTNER_APP_SECRET=''
SSO_FEISHU_PARTNER_TENANT_KEY=''

# Runtime account yice_sso_app (grants: schema/grants.sql, plus schema/grants.directory.sql with a directory).
SSO_MYSQL_HOST=''
SSO_MYSQL_PORT='3306'
SSO_MYSQL_USER='yice_sso_app'
SSO_MYSQL_PASSWORD=''
SSO_MYSQL_DB='yice_sso'
# Database holding the read-only member / dept directory.
SSO_DIRECTORY_DB='yice_information'

# One token per caller in config/callers.v1.json; deploy.sh appends missing ones (never edit by hand).
# SSO_CALLER_INFO_TOKEN / SSO_CALLER_TASK_TOKEN

# Health probe alerts (yice-sso-probe.timer), at most one per hour; see docs/feishu-apps.md. Leave all empty to disable.
# Feishu group custom bot: the webhook URL is a credential (server .env only); the secret enables signature checks.
SSO_ALERT_WEBHOOK=''
SSO_ALERT_WEBHOOK_SECRET=''
# Or / also: your own notification service.
NOTIFICATION_API_URL=''
NOTIFICATION_API_TOKEN=''
SSO_ALERT_TARGET=''
